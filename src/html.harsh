<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProjectXchange - Collaborative Student Project Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans">

    <!-- Navigation Bar -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold text-indigo-600 flex items-center gap-2">
                <span>⚡ ProjectXchange</span>
            </div>
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="#features" class="hover:text-indigo-600 transition">Features</a>
                <a href="#marketplace" class="hover:text-indigo-600 transition">Components</a>
                <a href="#guidance" class="hover:text-indigo-600 transition">Guidance</a>
                <a href="#about" class="hover:text-indigo-600 transition">About</a>
            </div>
            <div>
                <a href="#get-started" class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-indigo-700 transition shadow-sm">Get Started</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-blue-900 text-white py-24">
        <div class="max-w-7xl mx-auto px-6 text-center">
            <span class="bg-indigo-700 text-indigo-200 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4 inline-block">Student Project Platform</span>
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
                An Affordable & Collaborative <br class="hidden md:block"> Project Ecosystem for Students
            </h1>
            <p class="text-lg md:text-xl text-indigo-200 max-w-2xl mx-auto mb-10">
                Stop spending too much money on single-use components[span_2](start_span)[span_2](end_span). Buy, sell, rent, or exchange project hardware and get guidance from mentors[span_3](start_span)[span_3](end_span).
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#marketplace" class="bg-white text-indigo-900 font-semibold px-8 py-3.5 rounded-lg shadow hover:bg-slate-100 transition">Browse Components</a>
                <a href="#guidance" class="bg-indigo-600 border border-indigo-500 text-white font-semibold px-8 py-3.5 rounded-lg shadow hover:bg-indigo-700 transition">Get Project Guidance</a>
            </div>
        </div>
    </header>

    <!-- Core Features Section -->
    <section id="features" class="py-20 max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-4">Platform Deliverables & Features</h2>
            <p class="text-slate-600 max-w-xl mx-auto">Designed specifically for engineering, diploma, and science students to make project development easier[span_4](start_span)[span_4](end_span).</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature 1 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xl mb-6">🔄</div>
                <h3 class="text-xl font-semibold mb-3 text-slate-900">Rental & Exchange System</h3>
                <p class="text-slate-600 leading-relaxed">Rent, exchange, buy, or sell project components to reduce project costs and promote resource sharing[span_5](start_span)[span_5](end_span).</p>
            </div>

            <!-- Feature 2 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xl mb-6">💡</div>
                <h3 class="text-xl font-semibold mb-3 text-slate-900">Project Guidance Section</h3>
                <p class="text-slate-600 leading-relaxed">Overcome technical difficulties by connecting directly with experienced peers and mentors[span_6](start_span)[span_6](end_span).</p>
            </div>

            <!-- Feature 3 -->
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xl mb-6">⭐</div>
                <h3 class="text-xl font-semibold mb-3 text-slate-900">Rating & Review System</h3>
                <p class="text-slate-600 leading-relaxed">Build mutual trust within the student community through verified ratings, reviews, and secure transactions[span_7](start_span)[span_7](end_span).</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="text-xl font-bold text-white">ProjectXchange</div>
            <p class="text-sm text-center md:text-left">&copy; 2026 ProjectXchange. Creating an affordable and collaborative project ecosystem[span_8](start_span)[span_8](end_span).</p>
            <div class="flex space-x-6 text-sm">
                <a href="#" class="hover:text-white transition">Privacy Policy</a>
                <a href="#" class="hover:text-white transition">Terms of Service</a>
                <a href="#" class="hover:text-white transition">Contact Us</a>
            </div>
        </div>
    </footer>

</body>
</html>